{
  "name": "vue-easy-dnd",
  "version": "2.2.2",
  "description": "Drag and drop components for Vue 3 using mouse and touch events.",
  "type": "module",
  "main": "./dist/vue-easy-dnd.cjs",
  "module": "./dist/vue-easy-dnd.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-easy-dnd.global.js",
  "jsdelivr": "./dist/vue-easy-dnd.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-easy-dnd.mjs",
      "require": "./dist/vue-easy-dnd.cjs"
    },
    "./style.css": "./dist/dnd.css",
    "./dist/dnd.css": "./dist/dnd.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "mitt": "^3.0.1"
  },
  "peerDependencies": {
    "vue": "^3.2.25"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 11"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlemaigre/Easy-DnD.git"
  },
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "vuejs3",
    "drag-and-drop",
    "sortable",
    "dnd"
  ],
  "author": "Régis Lemaigre <rlemaigre.github@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rlemaigre/Easy-DnD/issues"
  },
  "homepage": "https://github.com/rlemaigre/Easy-DnD#readme"
}
