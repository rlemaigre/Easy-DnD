{
  "name": "vue-easy-dnd",
  "version": "2.2.2",
  "description": "Lightweight Vue 3 drag-and-drop components for sortable lists, nested drop zones, mouse, and touch input.",
  "type": "module",
  "main": "./dist/vue-easy-dnd.cjs",
  "module": "./dist/vue-easy-dnd.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-easy-dnd.global.js",
  "jsdelivr": "./dist/vue-easy-dnd.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-easy-dnd.mjs",
      "require": "./dist/vue-easy-dnd.cjs"
    },
    "./style.css": "./dist/dnd.css",
    "./dist/dnd.css": "./dist/dnd.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.2.25"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 11"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlemaigre/Easy-DnD.git"
  },
  "keywords": [
    "vue",
    "vuejs",
    "vue3",
    "vuejs3",
    "vue-dnd",
    "vue-drag-and-drop",
    "vue3-drag-and-drop",
    "drag-and-drop",
    "drag-drop",
    "draggable",
    "droppable",
    "sortable",
    "sortable-list",
    "reorderable",
    "drop-zone",
    "dnd",
    "touch",
    "typescript",
    "nuxt",
    "ssr"
  ],
  "author": "Régis Lemaigre <rlemaigre.github@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rlemaigre/Easy-DnD/issues"
  },
  "homepage": "https://rlemaigre.github.io/Easy-DnD/"
}
